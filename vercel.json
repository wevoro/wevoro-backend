
{
  "version": 2,
  "builds": [
    {
      "src": "dist/server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["dist/**"] }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/notification/run-expiration-check",
      "schedule": "0 8 * * *"
    }
  ]
}
